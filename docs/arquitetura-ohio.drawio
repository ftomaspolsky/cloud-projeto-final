        </mxCell>
        <mxCell id="aas" value="&lt;b&gt;Application Auto Scaling&lt;/b&gt;&lt;br&gt;2 políticas, uma por serviço" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_auto_scaling;" vertex="1" parent="regionais">
          <mxGeometry x="65" y="775" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="email" value="e-mail inscrito" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.email_notification;" vertex="1" parent="regionais">
          <mxGeometry x="310" y="775" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nota_sg" value="&lt;b&gt;Security groups encadeados&lt;/b&gt;&lt;br&gt;• &lt;b&gt;sg-alb&lt;/b&gt;: entra HTTP 80 de qualquer lugar.&lt;br&gt;• &lt;b&gt;sg-ecs&lt;/b&gt;: entra TCP 32768–65535 só do sg-alb (porta dinâmica do modo bridge). Sem SSH.&lt;br&gt;• &lt;b&gt;sg-rds&lt;/b&gt;: entra MySQL 3306 só do sg-ecs. Nenhuma saída.&lt;br&gt;Instâncias e banco ficam em sub-rede privada, sem IP público." style="rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#AAB7B8;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1110" width="520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="nota_escala" value="&lt;b&gt;Escala em dois níveis&lt;/b&gt;&lt;br&gt;• &lt;b&gt;atendimento&lt;/b&gt;: 2 a 16 tasks, alvo de 100 requisições por task (ALBRequestCountPerTarget).&lt;br&gt;• &lt;b&gt;operacoes&lt;/b&gt;: 1 a 4 tasks, alvo de 100 mensagens visíveis na fila por task.&lt;br&gt;• &lt;b&gt;instâncias&lt;/b&gt;: o Capacity Provider sobe o ASG quando falta lugar para task.&lt;br&gt;Tasks espalhadas por zona; drenagem e proteção de encerramento gerenciadas." style="rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#AAB7B8;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="1110" width="540" height="120" as="geometry" />
        </mxCell>
        <mxCell id="nota_falha" value="&lt;b&gt;Como cada falha é absorvida&lt;/b&gt;&lt;br&gt;• Modelo fora: o morador cai no menu guiado, com as mesmas regras.&lt;br&gt;• Fila fora: o evento fica na caixa de saída do banco e é publicado depois.&lt;br&gt;• Evento repetido: descartado por idempotência; não processável vai para a DLQ.&lt;br&gt;• Instância perdida: o ASG repõe e o ECS reagenda. Banco: failover Multi-AZ.&lt;br&gt;* primária e espera trocam de zona no failover." style="rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#AAB7B8;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;html=1;" vertex="1" parent="1">
