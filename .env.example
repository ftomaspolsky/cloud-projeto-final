# Copie para .env (que o git ignora) antes de rodar o docker compose.
# Estes valores são só do ambiente LOCAL. Na AWS, as credenciais do banco vêm do
# Secrets Manager, injetadas pelo ECS na task — nunca deste arquivo.

MYSQL_ROOT_PASSWORD=troque-localmente
DB_NAME=loja
DB_USER=app
DB_PASSWORD=troque-localmente-tambem
